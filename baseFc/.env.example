# =============================================================================
# BASE FC - GUIA DE VARIÁVEIS DE AMBIENTE (PRODUÇÃO / RENDER / VERCEL)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. VARIÁVEIS PARA O BACKEND (RENDER: Dashboard > Environment)
# -----------------------------------------------------------------------------
# URL do projeto Supabase (igual à usada localmente)
VITE_SUPABASE_URL=url.supabase.co
# Chave Secreta service_role do Supabase (NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_aleatoria

# Ambiente e Porta (o Render injeta PORT automaticamente)
NODE_ENV=production

# URL da Vercel (Frontend em produção) para onde os e-mails de convite apontam
APP_URL=https://seu-projeto.vercel.app

# CORS (Opcional - se vazio permite qualquer origem com credentials)
CORS_ORIGIN=https://seu-projeto.vercel.app

# -----------------------------------------------------------------------------
# 2. VARIÁVEIS PARA O FRONTEND (VERCEL: Project Settings > Environment Variables)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://url.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_aleatoria
VITE_API_URL=https://url.render.co

# -----------------------------------------------------------------------------
# 3. CONFIGURAÇÃO NO SUPABASE DASHBOARD (Authentication > URL Configuration)
# -----------------------------------------------------------------------------
# Site URL: https://seu-projeto.vercel.app
# Redirect URLs (Allow list):
#   - https://seu-projeto.vercel.app/**
#   - https://seu-projeto.vercel.app/definir-senha
#   - http://localhost:5173/**

